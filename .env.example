# Copy to .env.local and fill in. Real .env* files are gitignored; only this
# example is tracked. Never commit real secrets.

# --- AI chat assistant ("Mach") ---
# Used by src/app/api/chat and src/lib/providers/*.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Admin login (/admin) ---
ADMIN_PASS=

# --- Rate limiting (Upstash Redis / Vercel KV) ---
# Optional locally; set in production. Either the Upstash or KV pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Search-engine ownership verification (optional) ---
# When set, src/app/layout.tsx emits the matching <meta> tag in <head>.
# Google Search Console: use the "HTML tag" method and paste the token value
# (the content="..." part of the google-site-verification meta tag).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the msvalidate.01 content value. You can skip this and
# instead "Import from Google Search Console" in Bing Webmaster Tools.
BING_SITE_VERIFICATION=
