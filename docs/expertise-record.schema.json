{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Expertise record",
  "description": "One /expertise/[slug] page. Enforcement lives in src/data/expertise/schema.ts (zod); this mirror exists for editors and content-generation agents. Keep the two in sync. Every claim must be grounded in repo source files; no invented numbers, dates, or superlatives.",
  "type": "object",
  "required": ["slug", "title", "shortTitle", "metaDescription", "hero", "tags", "evidence", "tools", "relatedSlugs", "knowsAbout", "lastReviewed"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "kebab-case; must equal the filename" },
    "title": { "type": "string", "minLength": 8, "maxLength": 70, "description": "page H1" },
    "shortTitle": { "type": "string", "minLength": 3, "maxLength": 28, "description": "breadcrumb and related-card label" },
    "metaTitle": { "type": "string", "minLength": 8, "maxLength": 55, "description": "optional <title> override; defaults to title" },
    "metaDescription": { "type": "string", "minLength": 70, "maxLength": 160 },
    "hero": { "type": "string", "minLength": 120, "maxLength": 360, "description": "intro paragraph under the H1" },
    "tags": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 2, "maxLength": 32 } },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "description": "The substance of the page. Fewer than 3 items means the topic gets cut.",
      "items": {
        "type": "object",
        "required": ["context", "whatIDid", "outcome", "sourceUrl", "sourceLabel", "groundedIn"],
        "additionalProperties": false,
        "properties": {
          "context": { "type": "string", "minLength": 60, "maxLength": 300, "description": "where the work happened: org, course, or program" },
          "whatIDid": { "type": "string", "minLength": 120, "maxLength": 600, "description": "concrete work; specific nouns; no invented facts" },
          "outcome": { "type": "string", "minLength": 40, "maxLength": 300, "description": "result or artifact; numbers only if a source states them" },
          "sourceUrl": { "type": "string", "pattern": "^/[a-z0-9\\-/]*(#[a-z0-9\\-]+)?$", "description": "site-relative page where a visitor can verify" },
          "sourceLabel": { "type": "string", "minLength": 3, "maxLength": 60 },
          "groundedIn": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 }, "description": "repo file paths backing the claim; used by the fact-check pass" }
        }
      }
    },
    "courses": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["code", "note"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 3, "maxLength": 70 },
          "note": { "type": "string", "minLength": 20, "maxLength": 280 }
        }
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 30, "maxLength": 300 },
          "href": { "type": "string", "pattern": "^/[a-z0-9\\-/]*(#[a-z0-9\\-]+)?$" }
        }
      }
    },
    "tools": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
    "relatedSlugs": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "description": "must resolve to other records; no self-reference" },
    "knowsAbout": { "type": "string", "minLength": 3, "maxLength": 60, "description": "schema.org term merged into Person.knowsAbout" },
    "sameAs": { "type": "array", "maxItems": 3, "items": { "type": "string", "format": "uri" } },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
